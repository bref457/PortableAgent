    },
    {
      "canonical_name": "Problem",
      "aliases": ["Problem", "Probleme", "Stoerung", "Störung"],
      "role": "text",
      "data_type": "text",
      "description": "Freitext zu aufgetretenen Problemen",
      "allowed_operations": ["filter", "list"]
    }
