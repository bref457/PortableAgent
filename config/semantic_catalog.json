      "allowed_operations": ["filter", "group", "distinct", "count"]
    },
    {
      "canonical_name": "Datum",
      "aliases": ["Datum", "Date", "Einsatzdatum", "Tag"],
      "role": "dimension",
      "data_type": "date",
