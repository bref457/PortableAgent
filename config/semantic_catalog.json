      "allowed_aggregations": ["sum", "average", "min", "max"],
      "default_aggregation": "sum",
      "clarify_on_multiple": false,
      "non_negative": true
    },
    {
      "canonical_name": "Miliz",
      "aliases": ["Miliz", "Milizmitarbeiter", "Miliz-Mitarbeiter"],
      "role": "measure",
      "data_type": "number",
      "description": "Anzahl Milizmitarbeiter pro Eintrag",
      "unit": "Personen",
      "allowed_aggregations": ["sum", "average", "min", "max"],
      "default_aggregation": "sum",
      "clarify_on_multiple": false,
      "non_negative": true
    },
    {
