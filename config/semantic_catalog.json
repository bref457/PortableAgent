      "description": "Ende des Einsatzes als Uhrzeit beziehungsweise Dezimalstunde seit Mitternacht",
      "unit": "Uhrzeit",
      "allowed_operations": ["filter", "min", "max"]
    },
    {
      "canonical_name": "FIX",
