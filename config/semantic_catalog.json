      "allowed_operations": ["filter", "group", "min", "max"]
    },
    {
      "canonical_name": "von",
      "aliases": ["von", "Beginn", "Startzeit"],
      "role": "dimension",
      "data_type": "time",
      "description": "Beginn des Einsatzes als Uhrzeit beziehungsweise Dezimalstunde seit Mitternacht",
      "unit": "Uhrzeit",
      "allowed_operations": ["filter", "min", "max"]
    },
    {
      "canonical_name": "bis",
      "aliases": ["bis", "Ende", "Endzeit"],
      "role": "dimension",
